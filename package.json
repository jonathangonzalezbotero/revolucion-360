{
  "name": "revolucion-360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:status": "supabase migration list --remote",
    "db:migrate:check": "tsx scripts/check-migrations.ts && supabase db push --remote --dry-run",
    "db:migrate": "tsx scripts/check-migrations.ts && supabase db push --remote",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:types": "supabase gen types typescript --remote > /tmp/r360-types.ts && mv /tmp/r360-types.ts src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.11.0",
    "@stripe/stripe-js": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
