# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repositorio.

# Supabase (región Sydney en producción)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys. Sirven las nuevas (sb_publishable_… / sb_secret_…) o las legacy (anon / service_role).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (modo prueba hasta abrir al público)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (correos automáticos)
RESEND_API_KEY=
EMAIL_FROM="Revolución 360 <hola@revoluciondeldinero.com>"

# Tareas programadas de Vercel (recordatorios y vencimientos). También protege /api/crm/run (lo llama pg_cron, docs/CRM.md)
CRON_SECRET=

# CRM (docs/CRM.md)
# Remitente del marketing; si falta, EMAIL_FROM. Ej.: "Jonathan · Revolución 360 <hola@revoluciondeldinero.com>"
CRM_EMAIL_FROM=
CRM_REPLY_TO=
# OBSOLETA: /api/crm/ingest se reemplazó por las Conexiones web (Admin › Conexiones web, docs/CRM.md). Ya no se usa.
CRM_INGEST_KEY=
# Cloudflare Turnstile (anti-bots de las Conexiones web): clave SECRETA. La clave del sitio se guarda en el panel.
# Sin esta variable, todo envío desde el navegador se rechaza (los envíos desde servidor con la clave de la conexión siguen).
TURNSTILE_SECRET_KEY=
# Resend → Webhooks → Signing secret (whsec_…) para abiertos, clics, rebotes y quejas
RESEND_WEBHOOK_SECRET=
# Twilio (SMS). TWILIO_FROM: número E.164 (+61…) o el SID de un Messaging Service (MG…)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# URL pública del webhook de Twilio si no es NEXT_PUBLIC_APP_URL/api/crm/twilio
TWILIO_WEBHOOK_URL=
# Fuera de producción solo reciben SMS estos números (E.164, separados por coma)
SMS_TEST_NUMBERS=
# Correos / SMS por corrida del motor (por defecto 150 / 50)
CRM_EMAIL_BATCH=
CRM_SMS_BATCH=

# Notificaciones push (fase 3). Genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Usuarios de demostración locales (los crea `npm run seed:demo`). Inventa una contraseña.
DEMO_EMAIL=demo@revolucion360.test
DEMO_ADMIN_EMAIL=admin@revolucion360.test
DEMO_PASSWORD=

# Entrar con Google o Apple: actívalos primero en Supabase → Authentication → Providers
NEXT_PUBLIC_OAUTH_GOOGLE=false
NEXT_PUBLIC_OAUTH_APPLE=false
